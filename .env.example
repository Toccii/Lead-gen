# Copy this file to .env in the repo root (and to backend/.env if you run the
# backend outside docker-compose) and fill in the real values. Never commit .env.

# --- Environment ---
ENVIRONMENT=development
TIMEZONE=Europe/Rome

# --- Database (Postgres) ---
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen
POSTGRES_DB=leadgen
# Used by the backend; host "db" is the docker-compose service name, use
# localhost if running the backend directly on your machine.
DATABASE_URL=postgresql+psycopg://leadgen:leadgen@db:5432/leadgen

# --- Dashboard auth (single user) ---
SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DASHBOARD_ADMIN_EMAIL=you@yourcompany.com
DASHBOARD_ADMIN_PASSWORD=change-me

# --- Apollo.io sourcing ---
# Get this from https://app.apollo.io/#/settings/integrations/api -> API Keys
APOLLO_API_KEY=
# "mock" lets you run the full pipeline with fake leads before you have an Apollo key.
SOURCING_ADAPTER=mock

# --- Anthropic Claude (email copy generation) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Microsoft Graph (Outlook / Microsoft 365) ---
# See README.md "Azure AD app registration" section for how to obtain these.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_MAILBOX=you@yourcompany.com
# "application" = client-credentials flow (required for unattended cron jobs, no user login).
MS_GRAPH_AUTH_MODE=application

# --- Email sending behavior ---
# true = generate emails and log them, but never actually call Graph's /sendMail.
EMAIL_DRY_RUN=true
MAX_EMAILS_PER_DAY=30
UNSUBSCRIBE_BASE_URL=http://localhost:3000/unsubscribe

# --- Scheduling defaults (seeded into the system_settings table on first migration) ---
WEEKLY_JOB_DAY_OF_WEEK=0
WEEKLY_JOB_HOUR=8
DAILY_JOB_HOUR=9

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
